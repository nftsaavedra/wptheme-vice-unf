{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        {
          "slug": "viceunf-primary",
          "color": "#122a61",
          "name": "Azul Institucional"
        },
        {
          "slug": "viceunf-secondary",
          "color": "#ea5a0b",
          "name": "Naranja Institucional"
        },
        {
          "slug": "viceunf-tertiary",
          "color": "#00794e",
          "name": "Verde Institucional"
        },
        {
          "slug": "viceunf-legacy-pri2",
          "color": "#2d4260",
          "name": "Azul Obscuro"
        },
        {
          "slug": "viceunf-legacy-sec",
          "color": "#0b2346",
          "name": "Azul Medianoche"
        },
        {
          "slug": "viceunf-light",
          "color": "#fefbfa",
          "name": "Fondo Claro"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Negro"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "Blanco"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.85rem",
          "fluid": { "min": "0.75rem", "max": "0.85rem" },
          "name": "Extra Pequeño"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "fluid": { "min": "0.875rem", "max": "1rem" },
          "name": "Pequeño"
        },
        {
          "slug": "base",
          "size": "1.15rem",
          "fluid": { "min": "1rem", "max": "1.15rem" },
          "name": "Base"
        },
        {
          "slug": "base-alt",
          "size": "1.38rem",
          "fluid": { "min": "1.2rem", "max": "1.38rem" },
          "name": "Base Alt"
        },
        {
          "slug": "md",
          "size": "1.45rem",
          "fluid": { "min": "1.25rem", "max": "1.45rem" },
          "name": "Medio"
        },
        {
          "slug": "lg",
          "size": "2rem",
          "fluid": { "min": "1.5rem", "max": "2rem" },
          "name": "Grande"
        },
        {
          "slug": "xl",
          "size": "2.75rem",
          "fluid": { "min": "2rem", "max": "2.75rem" },
          "name": "Extra Grande"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    },
    "border": {
      "radiusSizes": [
        { "name": "Pequeño", "slug": "sm", "size": "4px" },
        { "name": "Medio",   "slug": "md", "size": "8px" },
        { "name": "Grande",  "slug": "lg", "size": "16px" }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1670px"
    },
    "blocks": {
      "core/image": {
        "color": { "defaultPalette": false }
      },
      "core/button": {
        "color": { "defaultPalette": false }
      }
    }
  },
  "styles": {
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var(--wp--preset--color--viceunf-tertiary)",
              "style": "solid",
              "width": "2px"
            },
            "color": {
              "background": "transparent",
              "text": "var(--wp--preset--color--viceunf-tertiary)"
            }
          }
        }
      }
    },
    "elements": {
      "button": {
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--viceunf-secondary)",
            "text": "var(--wp--preset--color--white)"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Cabecera",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pie de Página",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "index",
      "title": "Inicio (Fallback)"
    },
    {
      "name": "page",
      "title": "Página Estándar"
    },
    {
      "name": "single",
      "title": "Entrada Individual"
    },
    {
      "name": "archive",
      "title": "Archivo / Categoría"
    },
    {
      "name": "search",
      "title": "Resultados de Búsqueda"
    },
    {
      "name": "404",
      "title": "Página 404"
    }
  ]
}
