{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "color": {
      "palette": [
        {
          "slug": "viceunf-primary",
          "color": "#122a61",
          "name": "Azul Institucional"
        },
        {
          "slug": "viceunf-secondary",
          "color": "#ea5a0b",
          "name": "Naranja Institucional"
        },
        {
          "slug": "viceunf-tertiary",
          "color": "#00794e",
          "name": "Verde Institucional"
        },
        {
          "slug": "viceunf-legacy-pri2",
          "color": "#2d4260",
          "name": "Azul Obscuro"
        },
        {
          "slug": "viceunf-legacy-sec",
          "color": "#0b2346",
          "name": "Azul Medianoche"
        },
        {
          "slug": "viceunf-light",
          "color": "#fefbfa",
          "name": "Fondo Claro"
        },
        {
          "slug": "black",
          "color": "#000000",
          "name": "Negro"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "Blanco"
        }
      ],
      "custom": false
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.85rem",
          "fluid": {
            "min": "0.75rem",
            "max": "0.85rem"
          },
          "name": "Extra Pequeño"
        },
        {
          "slug": "sm",
          "size": "1rem",
          "fluid": {
            "min": "0.875rem",
            "max": "1rem"
          },
          "name": "Pequeño"
        },
        {
          "slug": "base",
          "size": "1.15rem",
          "fluid": {
            "min": "1rem",
            "max": "1.15rem"
          },
          "name": "Base"
        },
        {
          "slug": "base-alt",
          "size": "1.38rem",
          "fluid": {
            "min": "1.2rem",
            "max": "1.38rem"
          },
          "name": "Base Alt"
        },
        {
          "slug": "md",
          "size": "1.45rem",
          "fluid": {
            "min": "1.25rem",
            "max": "1.45rem"
          },
          "name": "Medio"
        },
        {
          "slug": "lg",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          },
          "name": "Grande"
        },
        {
          "slug": "xl",
          "size": "2.75rem",
          "fluid": {
            "min": "2rem",
            "max": "2.75rem"
          },
          "name": "Extra Grande"
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1670px"
    }
  }
}
