{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "viceunf/organigrama",
    "version": "1.0.0",
    "title": "Organigrama UNF",
    "category": "viceunf-blocks",
    "icon": "networking",
    "description": "Dibuja un organigrama jerárquico dinámico basado en las dependencias UNF.",
    "attributes": {
        "parentId": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true
        }
    },
    "textdomain": "viceunf",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}
